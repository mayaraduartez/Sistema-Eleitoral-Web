<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TSE Clone</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }

        body {
            background: #0047c7;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 40px;
        }

        .container {
            width: 95%;
            max-width: 1400px;
            background: white;
            border-radius: 20px;
            padding: 40px 50px;
            position: relative;
            overflow: hidden;
            min-height: 600px; 
        }

        .container::before {
            content: "";
            position: absolute;
             width: 1010px;
             height: 580px;
            background: #f3f5fb;
            border-radius: 50%;
            top: -150px; 
            right: -200px; 
            z-index: 0; 
        }

        .topo-barra {
            position: absolute;
            top: 20px;
            right: 30px;
            z-index: 10;
        }

        .botao-sair {
            background-color: #dc3545;
            color: white;
            border: none;
            padding: 12px 24px;
            font-size: 16px;
            font-weight: bold;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 2px 5px rgba(0,0,0,0.2);
        }

        .botao-sair:hover {
            background-color: #c82333;
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.3);
        }

        .hero {
            margin-top: 40px;
            display: flex;
            justify-content: space-between;
            align-items: center; 
            position: relative;
            z-index: 2;
            gap: 30px; 
        }

        .left {
            width: 35%;
            z-index: 2;
        }

        .left a {
            color: #0a45c9;
            font-weight: bold;
            text-decoration: none;
            border-bottom: 2px solid #0a45c9;
            padding-bottom: 4px;
            font-size: 18px;
        }

        .right {
            width: 50%;
            text-align: center;
            z-index: 2;
        }

        .right h2 {
            font-size: 64px;
            color: #0a45c9;
            line-height: 1.1;
            margin-bottom: 20px;
            font-weight: bold;
        }

        .right p {
            color: #666;
            font-size: 22px;
            margin-bottom: 30px;
        }

        .right a {
            color: #0a45c9;
            font-weight: bold;
            text-decoration: none;
            border-bottom: 2px solid #0a45c9;
            padding-bottom: 5px;
            font-size: 18px;
        }

        .cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 25px;
            margin-top: 60px;
            position: relative;
            z-index: 2;
        }

        .card {
            background: #f5f7ff;
            border-radius: 25px;
            padding: 40px 30px;
            text-align: center;
            min-height: 420px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: all .3s ease;
            cursor: pointer;
            border: 3px solid transparent;
            position: relative;
        }
        /* EFEITO HOVER DINÂMICO */
        .card:hover {
            background: #0047c7;
            transform: translateY(-10px) scale(1.02);
            border: 3px solid #4d8dff;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.20);
        }

        .card:hover h3,
        .card:hover p,
        .card:hover .link {
            color: white;
        }

        .card:hover .icon {
            transform: scale(1.1);
        }

        .icon {
            width: 120px;
            height: 120px;
            background: white;
            border-radius: 50%;
            margin: 0 auto 30px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 50px;
            color: #0047c7;
            transition: .3s;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .card h3 {
            font-size: 38px;
            margin-bottom: 20px;
            color: #0a45c9;
            transition: .3s;
        }

        .card p {
            font-size: 22px;
            line-height: 1.5;
            color: #555;
            transition: .3s;
        }

        .link {
            margin-top: 30px;
            color: #0a45c9;
            text-decoration: none;
            font-size: 20px;
            display: inline-block;
            transition: .3s;
            font-weight: bold;
        }

        .link:hover {
            text-decoration: underline;
        }

        @media(max-width:1200px) {
            .hero {
                flex-direction: column;
                gap: 40px;
            }

            .left,
            .right {
                width: 100%;
            }

            .right h2 {
                font-size: 42px;
            }
            
            .container::before {
                width: 400px;
                height: 400px;
                top: -200px;
                right: -100px;
            }
        }
    </style>
</head>

<body>
    <div class="container">
       
        <div class="topo-barra">
            <button type="button" class="botao-sair" id="btnSair">Sair</button>
        </div>
        
        <section class="hero">

            <div class="left">
                <a href="#">SAIBA MAIS</a>
            </div>

            <div class="right">
                <h2>
                    Justiça Eleitoral<br>
                    mais próxima de você
                </h2>
                <p>
                    Serviços digitais para facilitar sua participação na democracia.
                </p>
                <a href="#">
                    CONHEÇA TODOS OS SERVIÇOS
                </a>
            </div>
        </section>

        <!-- Cards DINÂMICOS -->
        <section class="cards" id="cards-container"></section>
    </div>

    <script>
        const servicos = [
            { icon: "👥", titulo: "Eleitores", descricao: "Cadastrar, editar, ativar e gerenciar eleitores." },
            { icon: "📍", titulo: "Zonas Eleitorais", descricao: "Cadastrar e gerenciar zonas eleitorais." },
            { icon: "🏫", titulo: "Seções Eleitorais", descricao: "Cadastrar e gerenciar seções eleitorais." },
            { icon: "🗳️", titulo: "Urnas", descricao: "Cadastrar e administrar urnas eletrônicas." },
            { icon: "👤", titulo: "Candidatos", descricao: "Cadastrar e gerenciar candidatos." },
            { icon: "🏛️", titulo: "Partidos", descricao: "Cadastrar e administrar partidos políticos." },
            { icon: "📋", titulo: "Chapas", descricao: "Cadastrar e gerenciar chapas eleitorais." },
            { icon: "📊", titulo: "Relatórios", descricao: "Visualizar resultados parciais e gerar relatórios da eleição." }
        ];

        // Mapeamento de rotas
        const rotas = {
            'Eleitores': '/gerenciarEleitor',
            'Zonas Eleitorais': '/gerenciarZonaEleitoral',
            'Seções Eleitorais': '/gerenciarSecaoEleitoral',
            'Urnas': '/cadastroUrnas',
            'Candidatos': '/gerenciarCandidato',
            'Partidos': '/gerenciarPartido',
            'Chapas': '/gerenciarChapas',
            'Relatórios': '/resultadoEleicao'
        };

        const container = document.getElementById("cards-container");

        // Criar cards
        servicos.forEach(servico => {
            const linkHref = rotas[servico.titulo] || '#';
            
            const card = document.createElement("div");
            card.classList.add("card");
            
            card.innerHTML = `
                <div class="icon">${servico.icon}</div>
                <div>
                    <h3>${servico.titulo}</h3>
                    <p>${servico.descricao}</p>
                </div>
                <a href="${linkHref}" class="link">Acessar módulo →</a>
            `;

            // Clique no card redireciona
            card.addEventListener('click', (e) => {
                // Não redireciona se clicar no link
                if (e.target.tagName.toLowerCase() !== 'a') {
                    window.location.href = linkHref;
                }
            });

            container.appendChild(card);
        });

        // Botão Sair
        document.getElementById('btnSair').addEventListener('click', function() {
            if (confirm('Tem certeza que deseja sair?')) {
                window.location.href = '/logout';
            }
        });
    </script>
</body>
</html>