<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <link rel="stylesheet" href="/css/style.css">

  <title>Resultado da Eleição</title>
</head>

<body>

  <div class="container-eleitor">

    <!-- CABEÇALHO -->
    <div class="cabecalho">

      <div class="subtitle">
        <h1>Resultados Parciais</h1>
        <p>Acompanhe os resultados parciais da eleição municipal.</p>
      </div>

      <div class="imagem">
        <img src="/images/Tribunal_Superior_Eleitoral.png" alt="Justiça Eleitoral">
      </div>

      <div class="info">
        <p>Dados oficiais da Justiça Eleitoral</p>
      </div>

    </div>

    <!-- RESUMO DOS VOTOS -->
    <div class="resumo-votos">

      <h2>Resumo dos Votos</h2>

      <div class="cards-votos">

        <div class="card-voto">
          Total de Votos:
          <strong>
            <%= totalGeral %>
          </strong>
        </div>

        <div class="card-voto">
          Votos Brancos:
          <strong>
            <%= votosBrancos %>
          </strong>
        </div>

        <div class="card-voto">
          Votos Válidos:
          <strong>
            <%= votosValidos %>
          </strong>
        </div>

        <div class="card-voto">
          Votos Nulos:
          <strong>
            <%= votosNulos %>
          </strong>
        </div>

      </div>

    </div>

    <!-- BOTÃO RELATÓRIO -->
    <div style="margin-bottom: 20px;">
          <button onclick="window.location.href='/homeAdmin'" class="btn botao-voltar" style="background: #666; width: auto; cursor: pointer;">Voltar</button>

      <form action="/gerar-relatorio" method="POST" target="_blank">
        <button type="submit" class="btn">
          Gerar Relatório
        </button>
      </form>

    </div>

    <!-- TABELA PREFEITO -->
    <div class="tabela-eleitores">

      <h2>Tabela Prefeito</h2>

      <table class="tabela">

        <thead>
          <tr>
            <th>Nome do Prefeito</th>
            <th>Nome do Vice</th>
            <th>Nome da Chapa</th>
            <th>Número</th>
            <th>Partido</th>
            <th>Votos Computados</th>
          </tr>
        </thead>

        <tbody>

          <% if(prefeitos.length> 0){ %>

            <% prefeitos.forEach((prefeito, index)=> { %>

              <tr class="<%= index === 0 ? 'vencedor' : '' %>">

                <td>
                  <%= prefeito.prefeitoNome %>

                    <% if(index === 0 && prefeito.total_votos > 0) { %>
                      <span class="badge-vencedor">
                        🏆 Eleito
                      </span>
                      <% } %>

                </td>

                <td>
                  <%= prefeito.viceNome %>
                </td>

                <td>
                  <%= prefeito.nome %>
                </td>

                <td>
                  <%= prefeito.numero %>
                </td>

                <td>
                  <%= prefeito.sigla %>
                </td>

                <td>
                  <%= prefeito.total_votos %>
                </td>

              </tr>

              <% }) %>

                <% } else { %>

                  <tr>
                    <td colspan="6">
                      Nenhum resultado encontrado.
                    </td>
                  </tr>

                  <% } %>

        </tbody>

      </table>

    </div>

    <!-- TABELA VEREADOR -->
    <div class="tabela-eleitores">

      <h2>Tabela Vereador</h2>

      <table class="tabela">

        <thead>
          <tr>
            <th>Nome</th>
            <th>Número</th>
            <th>Partido</th>
            <th>Votos Computados</th>
          </tr>
        </thead>

        <tbody>

          <% if(vereadores.length> 0){ %>

            <% vereadores.forEach((vereador, index)=> { %>

              <tr class="<%= index < numeroDeVagas ? 'eleito' : '' %>">

                <td>

                  <%= vereador.nome %>

                    <% if(index === 0 && vereador.total_votos > 0) { %>

                      <span class="badge-eleito">
                        🏆 Eleito
                      </span>

                      <% } %>

                </td>

                <td>
                  <%= vereador.numero %>
                </td>

                <td>
                  <%= vereador.sigla %>
                </td>

                <td>
                  <%= vereador.total_votos %>
                </td>

              </tr>

              <% }) %>

                <% } else { %>

                  <tr>
                    <td colspan="4">
                      Nenhum resultado encontrado.
                    </td>
                  </tr>

                  <% } %>

        </tbody>

      </table>

    </div>

    <!-- TABELA BRANCOS E NULOS -->
    <div class="tabela-eleitores">

      <h2>Votos em Branco e Nulos</h2>

      <table class="tabela">
        <thead>
          <tr>
            <th>Tipo de Voto</th>
            <th>Votos Computados</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Votos em Branco</td>
            <td><%= votosBrancos %></td>
          </tr>
          <tr>
            <td>Votos Nulos</td>
            <td><%= votosNulos %></td>
          </tr>
        </tbody>
      </table>

    </div>

  </div>

</body>

</html>